---
layout: page
---
<!-- Your regular page content -->
{{ content }}

<!-- Top-level tag display -->
{% assign all_tags = '' | split: ',' %}

{% if page.collection and page.collection.size > 0 %}
  {% assign collection = site[page.collection] %}
  {% if collection %}
    {% for item in collection %}
      {% if item.tags %}
        {% assign all_tags = all_tags | concat: item.tags %}
      {% endif %}
    {% endfor %}
    {% assign all_tags = all_tags | uniq %}

    {% if all_tags.size > 0 %}
      <div style="text-align:center; margin: 30px 0;">
        <hr style="border: 1px solid #ccc; margin: 0 0 10px 0;">
        <p class="post-tags" style="font-size:1.2em; margin: 0; line-height: 1.2;">
          <span style="color: grey; margin-right: 5px;"><i class="fa-solid fa-tags fa-sm"></i></span>
          {% for tag in all_tags %}
            <span style="color: grey;"><i class="fa-solid fa-hashtag fa-sm"></i></span>
            <a
              href="{{ tag | slugify | prepend: '/books/tag/' | relative_url }}"
              style="color:  #3c789c; text-decoration: none; margin: 0 4px;"
            >
              {{ tag }}
            </a>
            {% unless forloop.last %}
              <span style="color: grey;">&middot;</span>
            {% endunless %}
          {% endfor %}
        </p>
        <hr style="border: 1px solid #ccc; margin: 10px 0 0 0;">
      </div>
    {% endif %}
  {% endif %}
{% endif %}

{% if page.collection and page.collection.size > 0 %}
  {% assign grouped_by_year = collection | group_by_exp: 'item', "item.started | date: '%Y'" %}
  {% for year_group in grouped_by_year reversed %}
    <h1 id="y{{ year_group.name }}">
      <a href="{{ year_group.name | prepend: '/books/' | relative_url }}">{{ year_group.name }}</a>
    </h1>

    {% assign categories = 'Textbooks,Technical Reads,Non-Technical Reads,Fun/Other Reads,Chess Books' | split: ',' %}
    {% for category in categories %}
      {% assign books_in_category = year_group.items | where: 'book_type', category %}
      {% if books_in_category.size > 0 %}
        <h2>{{ category }}</h2>
        <ul>
          {% for item in books_in_category %}
            <figure class="cover">
              <a class="cover-link" href="{{ item.url | relative_url }}">
                {% if item.cover %}
                  <img alt="{{ item.title }} cover" src="{{ item.cover | prepend: page.covers | relative_url }}" style="height:200px">
                {% elsif item.olid %}
                  <img
                    alt="{{ item.title }} cover"
                    src="http://covers.openlibrary.org/b/olid/{{ item.olid }}-L.jpg?default=false"
                    style="height:200px"
                  >
                {% elsif item.isbn %}
                  <img
                    alt="{{ item.title }} cover"
                    src="http://covers.openlibrary.org/b/isbn/{{ item.isbn }}-L.jpg?default=false"
                    style="height:200px"
                  >
                {% endif %}

                {% if item.status %}
                  {% assign statuses = 'abandoned,finished,interested,paused,queued,reading,reread' | split: ',' %}
                  {% assign status = item.status | downcase | strip %}
                  {% if statuses contains status %}
                    <figcaption class="{{ status | downcase }}">{{ status | upcase }}</figcaption>
                  {% else %}
                    <figcaption class="uncategorized">UNCATEGORIZED</figcaption>
                  {% endif %}
                {% else %}
                  <figcaption class="uncategorized">UNCATEGORIZED</figcaption>
                {% endif %}
              </a>
            </figure>
          {% endfor %}
        </ul>
      {% endif %}
    {% endfor %}

    {% unless forloop.last %}
      <hr style="border: 0; height: 2px; background: #ccc; margin: 40px 0;">
    {% endunless %}
  {% endfor %}
{% endif %}
